{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**",
      "excludeFiles": "{public/**,src/**,dist/**,node_modules/**,test_*.py,*.md,*.zip,*.pem,*.txt}"
    }
  }
}
